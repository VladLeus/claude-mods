{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "types": []
  },
  // tdd-evidence/register-typecheck.sh type-checks register.tsx on an engine stub: typecheck:cadre has no engine types.
  "include": ["hooks/**/*.ts", "types/**/*.d.ts"],
  // register.test.ts drives register.tsx through the engine host API, so it only type-checks against the engine's
  // generated types. Its behaviour stays covered by `claude plugin test cadre`.
  "exclude": ["hooks/register.test.ts"]
}
